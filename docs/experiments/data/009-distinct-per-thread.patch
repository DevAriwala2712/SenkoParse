+/// COUNT(DISTINCT) on the parallel path (EXP-009, ADR-0004). A set union is exact and its result does not depend
+/// on how rows are split or in which order sets are merged, so DISTINCT states need not follow the fixed per-chunk
+/// merge order that keeps `f64` sums thread-independent. Per-chunk tables carry every other aggregate; DISTINCT
+/// states live in a few worker tables (same keys, DISTINCT aggregates only), one per concurrently running chunk
+/// task, so live sets are `workers x groups` instead of `chunks x groups` and there is no tree of set unions.
+/// At the end each final group's count is the size of the union of that group's sets over all workers.
+struct DistinctSide {
+    full: Arc<AggSpec>,
+    /// Per aggregate of `full`: `Ok(i)` = index in the per-chunk spec, `Err(d)` = index in the worker spec.
+    slots: Vec<std::result::Result<usize, usize>>,
+    ndistinct: usize,
+    workers: Vec<AggTable>,
+}
+
+impl DistinctSide {
+    /// Size of the union, over all workers, of DISTINCT aggregate `d`'s set for group `g` of `from`.
+    fn union_len(&self, from: &AggTable, g: usize, d: usize, buf: &mut Vec<u8>) -> i64 {
+        let sets: Vec<&FxSet<Box<[u8]>>> = self
+            .workers
+            .iter()
+            .filter_map(|w| {
+                let wg = w.find_group(from, g, buf)?;
+                match &w.states[wg * self.ndistinct + d] {
+                    St::Distinct(s) => Some(&**s),
+                    _ => unreachable!("worker table holds DISTINCT states only"),
+                }
+            })
+            .collect();
+        let Some(big) = (0..sets.len()).max_by_key(|&i| sets[i].len()) else { return 0 };
+        // Keys missing from the largest set, each counted once; borrowed, so nothing is copied.
+        let mut extra: FxSet<&[u8]> = FxSet::default();
+        for (i, s) in sets.iter().enumerate() {
+            if i != big {
+                for k in s.iter() {
+                    if !sets[big].contains(k) {
+                        extra.insert(&k[..]);
+                    }
+                }
+            }
+        }
+        (sets[big].len() + extra.len()) as i64
+    }
+}
